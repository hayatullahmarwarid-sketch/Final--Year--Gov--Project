NODE_ENV=development
PORT=4000
LOG_LEVEL=info
MONGODB_URI=mongodb://127.0.0.1:27017/sharia_decrees
CORS_ORIGIN=*
MAX_UPLOAD_BYTES=10485760

# ---------- MongoDB pool + timeout tuning (Phase 3) ----------
# MONGO_MAX_POOL_SIZE=50
# MONGO_MIN_POOL_SIZE=5
# MONGO_SOCKET_TIMEOUT_MS=45000
# MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
# MONGO_HEARTBEAT_FREQUENCY_MS=10000

# File storage: `disk` (local dev) or `s3` (AWS S3 / MinIO / R2 / Wasabi).
# STORAGE_PROVIDER=disk
# Local directory for uploaded blobs; mounted at GET /uploads/<filename>
# UPLOAD_DIR=uploads

# ---------- Push notifications (Phase 6) ----------
# Expo push access token. Optional for low volume; required by Expo when sending at scale.
# EXPO_ACCESS_TOKEN=
#
# Firebase Admin JSON (full service account object as a single-line JSON string).
# Enables FCM for native Android FCM tokens + web FCM tokens.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
#
# Public Firebase web SDK config (safe for browsers). Served at GET /api/v1/public-config/firebase-web
# FIREBASE_WEB_API_KEY=
# FIREBASE_WEB_AUTH_DOMAIN=
# FIREBASE_WEB_PROJECT_ID=
# FIREBASE_WEB_STORAGE_BUCKET=
# FIREBASE_WEB_MESSAGING_SENDER_ID=
# FIREBASE_WEB_APP_ID=
# FIREBASE_WEB_VAPID_KEY=

# ---------- S3-compatible storage (Phase 2, used when STORAGE_PROVIDER=s3) ----------
# S3_BUCKET=sharia-decrees-prod
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional endpoint for MinIO / R2 / Wasabi (omit for AWS S3):
# S3_ENDPOINT=https://s3.example.com
# S3_FORCE_PATH_STYLE=false         # true for MinIO / R2
# S3_PUBLIC_READ=false              # set true for CDN-cacheable public avatars / banners
# S3_PUBLIC_BASE_URL=https://cdn.example.com/sharia-decrees-prod
# S3_SIGNED_URL_TTL_SECONDS=900

# Optional dev default for `/api/v1/public/*` personalized routes when `X-Public-User-Id` is omitted
# PUBLIC_API_STANDALONE_USER_ID=6610f2b2f2b2f2b2f2b2f2f1

# JWT (required). Use long random strings in production.
JWT_SECRET=change-me-use-a-long-random-string-min-8-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-8-chars

# Access JWT TTL (seconds). Default 900 = 15 minutes.
# ACCESS_TOKEN_TTL_SECONDS=900
# Opaque refresh token TTL (seconds). Default 2592000 = 30 days.
# REFRESH_TOKEN_TTL_SECONDS=2592000

# Audit integrity: optional explicit HMAC key (min 8 chars). When omitted, the API derives a key from JWT_REFRESH_SECRET at boot.
# AUDIT_LOG_INTEGRITY_SECRET=use-a-long-random-secret-in-production
# Retention for `npm run audit:prune` and worker daily prune (days). Default in app schema: 365.
# AUDIT_LOG_RETENTION_DAYS=365

# Worker (`npm run worker`): enable hourly/daily cron ticks (assignment reminders, audit prune).
# WORKER_CRON_ENABLED=true

# Role checks for `authorize()` middleware. Set to `false` only for local dev without role-matched JWTs.
# Forbidden in production (boot-time check).
RBAC_ENFORCED=true

# ---------- Redis (optional in dev) ----------
# When unset, rate-limiting uses an in-memory store and the BullMQ queue runs in-process.
# In production, always set this for multi-instance deployments.
# REDIS_URL=redis://127.0.0.1:6379

# ---------- Rate limiting (Phase 1) ----------
# Disable only for load tests.
# RATE_LIMIT_ENABLED=true

# ---------- Account lockout (Phase 1) ----------
# Consecutive failed logins within LOGIN_FAIL_WINDOW_SECONDS trigger a lock for LOGIN_LOCK_SECONDS.
# LOGIN_MAX_FAILS=8
# LOGIN_FAIL_WINDOW_SECONDS=900
# LOGIN_LOCK_SECONDS=900

# ---------- 2FA seam (Phase 1) ----------
# The schema is in place; full enrolment/verify UX lands in a later phase.
# REQUIRE_2FA=false

# ---------- Dev header lockout (Phase 1) ----------
# Block X-Public-User-Id / X-Inspector-User-Id at runtime. Must be true in production.
# DISABLE_DEV_AUTH_HEADERS=true

# Safety guard for seed scripts (roles only — `npm run seed:roles`):
# Refuses unless ALLOW_DB_SEEDING=YES; refuses when NODE_ENV=production.
# Also refuses when DISABLE_DB_SEEDING=YES.
# ALLOW_DB_SEEDING=YES
# DISABLE_DB_SEEDING=YES

# Optional future claims tuning
# JWT_ISSUER=
# JWT_AUDIENCE=
# ACCESS_TOKEN_TTL_SECONDS=900

# Outbound email — required together: SMTP_HOST, SMTP_PORT, MAIL_FROM
# Enables: POST /auth/email-verification/send, verification email on public register, password reset mail.
#
# On boot the API runs nodemailer verify() once and logs a warning if SMTP is misconfigured.
# SMTP_SKIP_BOOT_VERIFY=true  # optional: skip verify() on startup
#
# Gmail (Google Workspace / consumer): use port 587, SMTP_SECURE=false (STARTTLS is applied automatically).
# Use an App Password (Google Account → Security → 2-Step → App passwords), not your normal password.
# MAIL_FROM should normally use the same mailbox as SMTP_USER for Gmail.
# Local catch-all (Mailpit / MailHog): SMTP_HOST=127.0.0.1 SMTP_PORT=1025 SMTP_TLS_REJECT_UNAUTHORIZED=false
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-address@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM="Sharia Decrees <your-address@gmail.com>"
#
# Optional: force STARTTLS off (legacy relays only)
# SMTP_REQUIRE_TLS=false
# Optional: allow self-signed SMTP TLS (local dev mail tools)
# SMTP_TLS_REJECT_UNAUTHORIZED=false
#
# Public web/API base (optional). Used as fallback for verification + password-reset links when
# `EMAIL_VERIFICATION_APP_URL` is unset (e.g. same host serves deep links).
# APP_PUBLIC_BASE_URL=https://api.example.com

# Deep link opened from the email (verification + password reset). Use https web URL or Expo dev client, e.g.:
# EMAIL_VERIFICATION_APP_URL=https://your-host/--/verify-email
# EMAIL_VERIFICATION_APP_URL=exp://192.168.1.10:8081/--/verify-email
# EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
# EMAIL_VERIFICATION_HMAC_SECRET=optional-min-8-chars-defaults-to-JWT_REFRESH_SECRET
# Password reset email (public users): POST /api/v1/auth/password-reset/request | /complete
# PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
# PASSWORD_RESET_HMAC_SECRET=optional-min-8-chars-defaults-to-JWT_REFRESH_SECRET
