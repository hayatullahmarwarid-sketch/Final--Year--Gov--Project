{
  "name": "sharia-decrees-api",
  "version": "0.1.0",
  "private": true,
  "description": "Production-oriented API foundation for Sharia Decrees (modular monolith)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "worker:dev": "node --watch src/worker.js",
    "seed:roles": "node scripts/seed-roles.js",
    "test": "node -e \"console.log('No bundled automated tests.'); process.exit(0)\"",
    "verify": "npm run test",
    "db:migrate": "node database/migrations/run.js up",
    "db:migrate:status": "node database/migrations/run.js status",
    "db:migrate:down": "node database/migrations/run.js down",
    "openapi:types": "openapi-typescript api/docs/openapi.yaml -o ../lib/api/generated/types.ts",
    "audit:prune": "node scripts/prune-audit-logs.js",
    "db:prune-users": "node scripts/prune-users-for-fresh-start.js",
    "db:reset-runtime": "node scripts/reset-runtime-data.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1035.0",
    "@aws-sdk/s3-request-presigner": "^3.1035.0",
    "@expo-google-fonts/noto-naskh-arabic": "^0.4.5",
    "@fontsource/noto-naskh-arabic": "^5.2.7",
    "arabic-persian-reshaper": "^1.0.1",
    "bcryptjs": "^3.0.3",
    "bidi-js": "^1.0.3",
    "bullmq": "^5.76.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.4.0",
    "firebase-admin": "^12.7.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.3.5",
    "mongoose": "^8.9.5",
    "multer": "^2.1.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.5",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.18.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "playwright": "^1.59.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^4.1.1",
    "openapi-typescript": "^7.13.0"
  }
}
