# Example env for running the API via `docker compose up` against the bundled Mongo + Redis.
# Copy to `.env.docker` if you want to override compose defaults without editing the yml.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

MONGODB_URI=mongodb://mongo:27017/sharia_decrees?replicaSet=rs0
REDIS_URL=redis://redis:6379

JWT_SECRET=change-me-local-compose-only
JWT_REFRESH_SECRET=change-me-refresh-local-compose-only

CORS_ORIGIN=*

STORAGE_PROVIDER=disk
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=10485760

RATE_LIMIT_ENABLED=true

# Mailpit SMTP catcher (UI at http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_TLS_REJECT_UNAUTHORIZED=false
MAIL_FROM=Sharia Decrees <noreply@local.test>
