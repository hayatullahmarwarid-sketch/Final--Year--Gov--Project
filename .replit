modules = ["nodejs-20"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
NODE_ENV = "development"
PORT = "5000"
LOG_LEVEL = "info"
MONGODB_URI = "mongodb://127.0.0.1:27017/sharia_decrees"
CORS_ORIGIN = "*"
JWT_SECRET = "dev-jwt-secret-change-in-production-min8"
JWT_REFRESH_SECRET = "dev-refresh-secret-change-in-production-min8"
RBAC_ENFORCED = "true"
STORAGE_PROVIDER = "disk"
UPLOAD_DIR = "uploads"
RATE_LIMIT_ENABLED = "true"
SMTP_SKIP_BOOT_VERIFY = "true"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "vm"
run = ["bash", "start.sh"]
